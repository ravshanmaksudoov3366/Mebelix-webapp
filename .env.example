# Ushbu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring

# @BotFather bergan token
BOT_TOKEN=1234567890:AAH...

# Admin(lar) Telegram ID raqami. Bir nechta bo'lsa vergul bilan: 111111,222222
# ID ni bilish uchun botga /id deb yozing
ADMIN_IDS=123456789

# Mini App ochiladigan HTTPS manzil (server domeni)
WEBAPP_URL=https://mebel.example.uz/

# Do'kon ma'lumotlari (ilovada va botda ko'rinadi)
SHOP_NAME=iSofa
SHOP_PHONE=+998 99 333 33 66
SHOP_ADDRESS=Toshkent, Chilonzor tumani, 9-kvartal

# Buyurtmalar qo'shimcha yuboriladigan Telegram guruh ID (ixtiyoriy)
GROUP_ID=

# Server porti
PORT=8080

# Instagram / Facebook avto-post (ixtiyoriy)
META_TOKEN=
FB_PAGE_ID=
